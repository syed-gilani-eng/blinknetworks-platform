---
// Custom editorial artwork (no vendor logos, no baked-in text): app/public/images/insights/
const articles = [
  {
    category: "CYBERSECURITY",
    title: "5 Cybersecurity Essentials for Growing Businesses",
    imageSrc: "/images/insights/cybersecurity-essentials.webp",
    imagePosition: "center right",
  },
  {
    category: "MICROSOFT 365",
    title: "What's New in Microsoft 365 (and Why It Matters)",
    imageSrc: "/images/insights/microsoft-365-insights.webp",
    imagePosition: "center right",
  },
  {
    category: "MANAGED IT",
    title: "Is It Time for a Managed IT Provider?",
    imageSrc: "/images/insights/managed-it-provider.webp",
    imagePosition: "center center",
  },
];
---

<section class="insights" aria-labelledby="insights-heading">
  <div class="insights__inner">
    <header class="insights__header">
      <p class="insights__eyebrow">INSIGHTS</p>
      <h2 id="insights-heading" class="insights__heading">
        Latest insights and resources.
      </h2>
      <p class="insights__lead">
        Practical advice, industry trends and IT best practices.
      </p>
      <a class="insights__cta" href="/insights/">View All Articles &rarr;</a>
    </header>

    <ul class="insights__grid">
      {
        articles.map((article) => (
          <li>
            <article class="insight-card">
              <img
                class="insight-card__image"
                src={article.imageSrc}
                width="1680"
                height="945"
                alt=""
                loading="lazy"
                decoding="async"
                style={`object-position: ${article.imagePosition};`}
              />
              <div class="insight-card__overlay" aria-hidden="true" />
              <div class="insight-card__content">
                <p class="insight-card__category">{article.category}</p>
                <h3 class="insight-card__title">{article.title}</h3>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the Cloud Technology Stack section above. */
  .insights {
    background-color: var(--color-white);
  }

  .insights__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 24px 28px;
  }

  @media (min-width: 640px) {
    .insights__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 26px 30px;
    }
  }

  @media (min-width: 960px) {
    .insights__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 28px 32px;
    }
  }

  /* Compact editorial strip: intro column beside the card row rather than stacked above it. */
  @media (min-width: 1200px) {
    .insights__inner {
      padding-block: 26px 26px;
      display: grid;
      grid-template-columns: minmax(400px, 0.9fr) minmax(0, 2.1fr);
      align-items: center;
      gap: 24px;
    }
  }

  .insights__header {
    max-width: 60ch;
    margin-bottom: 24px;
  }

  @media (min-width: 960px) {
    .insights__header {
      margin-bottom: 28px;
    }
  }

  @media (min-width: 1200px) {
    .insights__header {
      max-width: none;
      margin-bottom: 0;
    }
  }

  .insights__eyebrow {
    margin: 0 0 10px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insights__heading {
    margin: 0 0 12px;
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .insights__heading {
      font-size: var(--font-size-h2);
    }
  }

  /* Slightly more compact editorial H2 once the intro sits beside the card row. */
  @media (min-width: 1200px) {
    .insights__heading {
      margin: 0 0 10px;
      font-size: 2rem;
    }
  }

  .insights__lead {
    margin: 0 0 16px;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  @media (min-width: 1200px) {
    .insights__eyebrow {
      margin-bottom: 8px;
    }

    .insights__lead {
      margin-bottom: 14px;
    }
  }

  /* Compact secondary button; Secondary Navy (not Blink Blue) meets AA for white button text on this light surface. */
  .insights__cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 9px 16px;
    border-radius: var(--radius-button);
    background-color: var(--color-secondary-navy);
    color: var(--color-white);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-fast) ease;
  }

  .insights__cta:hover,
  .insights__cta:focus-visible {
    background-color: var(--color-blink-navy);
  }

  .insights__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    min-width: 0;
  }

  @media (min-width: 760px) {
    .insights__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .insights__grid > li {
    min-width: 0;
  }

  /* Short, wide editorial banner: the card's own aspect-ratio controls its height, never the intro column. */
  .insight-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 760px) {
    .insight-card {
      aspect-ratio: 2.35 / 1;
    }
  }

  .insight-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Restrained dark gradient keeps overlaid text readable without excessively darkening the artwork. */
  .insight-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(7, 26, 45, 0.95) 0%,
      rgba(7, 26, 45, 0.62) 50%,
      rgba(7, 26, 45, 0.1) 100%
    );
  }

  .insight-card__content {
    position: relative;
    min-width: 0;
    padding: 12px 14px;
  }

  .insight-card__category {
    margin: 0 0 4px;
    color: var(--color-network-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insight-card__title {
    margin: 0;
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: normal;
    word-break: normal;
  }
</style>
