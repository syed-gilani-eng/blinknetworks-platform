---
interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" }: Props = Astro.props;

const logoSrc =
  variant === "dark"
    ? "/brand/blinknetworks-logo-dark-background.png"
    : "/brand/blinknetworks-logo-light-background.png";

const navItems = [
  { label: "Services", href: "/services/" },
  { label: "Solutions", href: "/solutions/" },
  { label: "Why BlinkNetworks", href: "/why-blinknetworks/" },
  { label: "Insights", href: "/insights/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];
---

<header class="site-header" data-nav-enhanced="false" data-variant={variant}>
  <div class="site-header__inner">
    <a class="site-header__logo" href="/">
      <img
        class="site-header__logo-img"
        src={logoSrc}
        width="2016"
        height="422"
        alt="BlinkNetworks"
      />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-nav-toggle
      hidden
    >
      <span class="visually-hidden">Toggle navigation menu</span>
      <span class="site-header__toggle-bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav
      class="site-nav"
      aria-label="Primary"
      id="primary-navigation"
      data-nav
    >
      <ul class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="site-nav__cta" href="/contact/">Book a Consultation</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-white);
  }

  .site-header__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    min-height: 76px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .site-header__inner {
      padding-inline: var(--container-padding-tablet);
    }
  }

  @media (min-width: 960px) {
    .site-header__inner {
      flex-wrap: nowrap;
      padding-inline: var(--container-padding-desktop);
    }
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo-img {
    display: block;
    height: 34px;
    width: auto;
  }

  @media (min-width: 960px) {
    .site-header__logo-img {
      height: 40px;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-white);
    cursor: pointer;
  }

  /* Belt-and-braces: keep the toggle hidden pre-enhancement even if a rule
     below sets `display` on the same class. */
  .site-header__toggle[hidden] {
    display: none;
  }

  .site-header__toggle-bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .site-header__toggle-bars span {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: var(--color-text-primary);
  }

  /* Progressive-enhancement baseline: nav is visible/usable without JS. */
  .site-nav {
    display: block;
    width: 100%;
    padding-block: 16px 24px;
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-text-primary);
    font-size: var(--font-size-body);
  }

  .site-nav__list a:hover,
  .site-nav__list a:focus-visible {
    color: var(--color-secondary-navy);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 12px;
    padding-inline: 20px;
    border-radius: var(--radius-button);
    background-color: var(--color-secondary-navy);
    color: var(--color-white);
    text-decoration: none;
    font-weight: 600;
    transition: background-color var(--duration-fast) ease;
  }

  .site-nav__cta:hover {
    background-color: var(--color-blink-navy);
  }

  /* Only once JS has enhanced the header does the nav collapse behind the toggle. */
  @media (max-width: 959px) {
    .site-header[data-nav-enhanced="true"] .site-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background-color: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      padding-inline: var(--container-padding-mobile);
    }

    .site-header[data-nav-enhanced="true"] .site-nav[data-open="true"] {
      display: block;
    }
  }

  @media (min-width: 960px) {
    .site-header__toggle {
      display: none;
    }

    .site-nav {
      display: flex;
      width: auto;
      align-items: center;
      gap: 32px;
      padding-block: 0;
    }

    .site-nav__list {
      flex-direction: row;
      align-items: center;
      gap: 28px;
    }

    .site-nav__list a {
      min-height: auto;
    }

    .site-nav__cta {
      margin-top: 0;
    }
  }

  /* Dark variant: same Blink Navy as the Hero so the two form one continuous band. */
  .site-header[data-variant="dark"] {
    background-color: var(--color-blink-navy);
    border-bottom-color: transparent;
  }

  .site-header[data-variant="dark"] .site-header__toggle {
    background: transparent;
    border-color: var(--color-white);
  }

  .site-header[data-variant="dark"] .site-header__toggle-bars span {
    background: var(--color-white);
  }

  .site-header[data-variant="dark"] .site-nav__list a {
    color: var(--color-white);
  }

  .site-header[data-variant="dark"] .site-nav__list a:hover,
  .site-header[data-variant="dark"] .site-nav__list a:focus-visible {
    color: var(--color-network-cyan);
  }

  /* Blink Blue fails AA for normal-size text/backgrounds; Network Cyan + navy text passes. */
  .site-header[data-variant="dark"] .site-nav__cta {
    background-color: var(--color-network-cyan);
    color: var(--color-blink-navy);
  }

  .site-header[data-variant="dark"] .site-nav__cta:hover {
    background-color: var(--color-soft-azure);
  }

  .site-header[data-variant="dark"] :focus-visible {
    outline-color: var(--color-network-cyan);
  }

  @media (max-width: 959px) {
    .site-header[data-variant="dark"][data-nav-enhanced="true"] .site-nav {
      background-color: var(--color-blink-navy);
      border-bottom-color: var(--color-secondary-navy);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav-enhanced]");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-nav-toggle]",
  );
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (header && toggle && nav) {
    // Only collapse the nav behind the toggle once JS has actually run.
    header.setAttribute("data-nav-enhanced", "true");
    toggle.hidden = false;

    const closeNav = () => {
      toggle.setAttribute("aria-expanded", "false");
      nav.setAttribute("data-open", "false");
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      nav.setAttribute("data-open", String(!isOpen));
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        closeNav();
        toggle.focus();
      }
    });
  }
</script>
