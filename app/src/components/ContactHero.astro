---
---

<section class="contact-hero" aria-labelledby="contact-hero-heading">
  <div class="contact-hero__inner">
    <div class="contact-hero__content">
      <p class="contact-hero__eyebrow">CONTACT BLINKNETWORKS</p>
      <h1 id="contact-hero-heading" class="contact-hero__heading">
        Let&rsquo;s talk about what your business needs
      </h1>
      <p class="contact-hero__lead">
        BlinkNetworks is a Canadian-owned technology partner supporting
        organizations across Toronto and the GTA with practical IT, cloud,
        security and infrastructure guidance.
      </p>
    </div>

    <!-- Approved production illustration; decorative, since the adjacent copy communicates the section meaning. -->
    <div class="contact-hero__visual">
      <img
        class="contact-hero__image"
        src="/images/contact/contact-hero.webp"
        width="1536"
        height="1024"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  /* Compact hero: no CTA here since the form directly below is the primary action. */
  .contact-hero {
    background-color: var(--color-blink-navy);
    color: var(--color-white);
    overflow: hidden;
  }

  .contact-hero__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .contact-hero__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px;
    }
  }

  @media (min-width: 960px) {
    .contact-hero__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 40px;
    }
  }

  .contact-hero__content {
    max-width: 46ch;
  }

  @media (min-width: 960px) {
    .contact-hero__content {
      max-width: none;
    }
  }

  .contact-hero__eyebrow {
    margin: 0 0 16px;
    color: var(--color-network-cyan);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-hero__heading {
    margin: 0 0 16px;
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-white);
  }

  @media (min-width: 960px) {
    .contact-hero__heading {
      font-size: var(--font-size-h2);
    }
  }

  .contact-hero__lead {
    margin: 0;
    max-width: 46ch;
    color: var(--color-soft-azure);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .contact-hero__visual {
    display: flex;
    justify-content: center;
  }

  .contact-hero__image {
    width: 100%;
    max-width: 420px;
    height: auto;
    object-fit: contain;
  }

  @media (min-width: 960px) {
    .contact-hero__image {
      max-width: none;
    }
  }
</style>
