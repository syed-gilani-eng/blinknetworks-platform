---
// Reused existing homepage icons (same six used by ServicesList.astro): app/public/images/homepage/icons/
const reasons = [
  {
    title: "Managed IT & Help Desk",
    description: "Ongoing issues, slow support, or you need a dependable team behind your technology.",
    iconSrc: "/images/homepage/icons/managed-it-support.svg",
  },
  {
    title: "Microsoft 365 & Endpoint Management",
    description: "Your Microsoft 365 environment feels disorganized, insecure or underused.",
    iconSrc: "/images/homepage/icons/productivity-collaboration.svg",
  },
  {
    title: "Cybersecurity",
    description: "You want a clearer picture of your security risks and how to reduce them.",
    iconSrc: "/images/homepage/icons/cybersecurity.svg",
  },
  {
    title: "Cloud & Infrastructure",
    description: "You're planning a cloud move, or your infrastructure needs a stronger foundation.",
    iconSrc: "/images/homepage/icons/cloud-infrastructure.svg",
  },
  {
    title: "Network Services",
    description: "Connectivity issues, growth, or a new location are putting pressure on your network.",
    iconSrc: "/images/homepage/icons/network-services.svg",
  },
  {
    title: "Backup & Business Continuity",
    description: "You need confidence that your data and operations can recover from disruption.",
    iconSrc: "/images/homepage/icons/business-continuity.svg",
  },
];
---

<section class="contact-help" aria-labelledby="contact-help-heading">
  <div class="contact-help__inner">
    <header class="contact-help__header">
      <p class="contact-help__eyebrow">COMMON REASONS TO REACH OUT</p>
      <h2 id="contact-help-heading" class="contact-help__heading">How can we help?</h2>
    </header>

    <ul class="contact-help__cards">
      {
        reasons.map((reason) => (
          <li class="contact-help__card">
            <img
              class="contact-help__icon"
              src={reason.iconSrc}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="contact-help__card-title">{reason.title}</h3>
            <p class="contact-help__card-description">{reason.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the Cloud contact-main section above. */
  .contact-help {
    background-color: var(--color-white);
  }

  .contact-help__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
  }

  @media (min-width: 640px) {
    .contact-help__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .contact-help__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
    }
  }

  .contact-help__header {
    margin: 0 0 28px;
    max-width: 60ch;
  }

  .contact-help__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-help__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .contact-help__heading {
      font-size: 2.25rem;
    }
  }

  .contact-help__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .contact-help__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .contact-help__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }

    .contact-help__card {
      height: 100%;
    }
  }

  .contact-help__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: 20px 18px;
  }

  .contact-help__icon {
    width: 28px;
    height: 28px;
  }

  .contact-help__card-title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .contact-help__card-description {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
