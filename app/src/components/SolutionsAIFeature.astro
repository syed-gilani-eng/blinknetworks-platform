---
// Reused existing homepage icons (no new assets); intentionally does not reuse copilot-ai.svg
// or ServicesAIFeature's left-content/right-list structure. Assets: app/public/images/homepage/icons/
const themes = [
  {
    title: "Find the Right Opportunities",
    description: "Prioritize realistic use cases tied to measurable business needs.",
    iconSrc: "/images/homepage/icons/process-assess.svg",
  },
  {
    title: "Build on a Secure Foundation",
    description: "Protect organizational data and establish responsible-use guardrails.",
    iconSrc: "/images/homepage/icons/cybersecurity.svg",
  },
  {
    title: "Start Small and Prove Value",
    description: "Pilot focused solutions before expanding across the organization.",
    iconSrc: "/images/homepage/icons/process-plan.svg",
  },
  {
    title: "Prepare People for Change",
    description: "Support training, adoption and continuous improvement.",
    iconSrc: "/images/homepage/icons/productivity-collaboration.svg",
  },
];
---

<section
  id="practical-ai-adoption"
  class="solutions-ai-feature"
  aria-labelledby="solutions-ai-feature-heading"
>
  <div class="solutions-ai-feature__inner">
    <div class="solutions-ai-feature__header">
      <p class="solutions-ai-feature__eyebrow">FEATURED SOLUTION</p>
      <h2 id="solutions-ai-feature-heading" class="solutions-ai-feature__heading">
        Practical AI Adoption
      </h2>
      <p class="solutions-ai-feature__lead">
        Turn useful AI ideas into secure, manageable solutions that save
        time, support better decisions and fit the way your organization
        works.
      </p>
    </div>

    <ul class="solutions-ai-feature__cards">
      {
        themes.map((theme) => (
          <li class="solutions-ai-feature__card">
            <img
              class="solutions-ai-feature__icon"
              src={theme.iconSrc}
              width="36"
              height="36"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="solutions-ai-feature__card-title">{theme.title}</h3>
            <p class="solutions-ai-feature__card-description">{theme.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="solutions-ai-feature__action">
      <a class="solutions-ai-feature__cta" href="/contact/">Discuss Your AI Goals</a>
    </div>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the Cloud Background solutions list above. */
  .solutions-ai-feature {
    background-color: var(--color-blink-navy);
  }

  .solutions-ai-feature__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }

  @media (min-width: 640px) {
    .solutions-ai-feature__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .solutions-ai-feature__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
    }
  }

  .solutions-ai-feature__header {
    max-width: 62ch;
  }

  .solutions-ai-feature__eyebrow {
    margin: 0 0 16px;
    color: var(--color-network-cyan);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .solutions-ai-feature__heading {
    margin: 0 0 16px;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-white);
  }

  @media (min-width: 960px) {
    .solutions-ai-feature__heading {
      font-size: 2.25rem;
    }
  }

  .solutions-ai-feature__lead {
    margin: 0;
    color: var(--color-soft-azure);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .solutions-ai-feature__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .solutions-ai-feature__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .solutions-ai-feature__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }

  /* Solid white surface over the navy section: no transparency/blur effects. */
  .solutions-ai-feature__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: 24px 20px;
  }

  .solutions-ai-feature__icon {
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
  }

  .solutions-ai-feature__card-title {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .solutions-ai-feature__card-description {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .solutions-ai-feature__action {
    margin-top: 4px;
  }

  .solutions-ai-feature__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: var(--radius-button);
    background-color: var(--color-network-cyan);
    color: var(--color-blink-navy);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-fast) ease;
  }

  .solutions-ai-feature__cta:hover,
  .solutions-ai-feature__cta:focus-visible {
    background-color: var(--color-soft-azure);
  }

  .solutions-ai-feature :focus-visible {
    outline-color: var(--color-network-cyan);
  }
</style>
