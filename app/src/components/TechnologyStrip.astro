---
// Neutral BlinkNetworks-styled category icons (not vendor logos/wordmarks).
// Assets: app/public/images/homepage/icons/
const technologies = [
  { name: "Microsoft 365", iconSrc: "/images/homepage/icons/productivity-collaboration.svg" },
  { name: "Azure", iconSrc: "/images/homepage/icons/cloud-infrastructure.svg" },
  { name: "Entra ID", iconSrc: "/images/homepage/icons/identity-access.svg" },
  { name: "Intune", iconSrc: "/images/homepage/icons/endpoint-management.svg" },
  { name: "Microsoft Defender", iconSrc: "/images/homepage/icons/cybersecurity.svg" },
  { name: "VMware", iconSrc: "/images/homepage/icons/virtualization-operations.svg" },
];
---

<section class="tech-strip" aria-labelledby="technology-strip-heading">
  <h2 id="technology-strip-heading" class="visually-hidden">
    Technologies we work with
  </h2>
  <div class="tech-strip__inner">
    <ul class="tech-strip__list">
      {
        technologies.map((tech) => (
          <li class="tech-strip__item">
            <span class="tech-strip__icon-badge">
              <img
                class="tech-strip__icon"
                src={tech.iconSrc}
                width="40"
                height="40"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="tech-strip__name">{tech.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Subtle shaded surface distinguishes this band from the Hero above and the white Business Problem section below. */
  .tech-strip {
    background-color: var(--color-cloud-bg);
  }

  .tech-strip__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 20px 14px;
  }

  @media (min-width: 640px) {
    .tech-strip__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 18px 14px;
    }
  }

  @media (min-width: 960px) {
    .tech-strip__inner {
      padding-inline: var(--container-padding-desktop);
    }
  }

  /* Mobile: fixed 2-column grid so wrapping is always balanced (3 rows x 2). */
  .tech-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 16px;
  }

  /* Tablet: balanced 3-column grid (2 rows x 3) rather than one cramped row. */
  @media (min-width: 640px) and (max-width: 959px) {
    .tech-strip__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px 24px;
      justify-items: center;
    }
  }

  @media (min-width: 960px) {
    .tech-strip__list {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
  }

  .tech-strip__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .tech-strip__item {
      justify-content: center;
    }
  }

  /* White base keeps the badge visible against the section's own Cloud background. */
  .tech-strip__icon-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background:
      radial-gradient(circle at 32% 28%, rgba(25, 118, 233, 0.1), rgba(42, 197, 232, 0.03) 65%, transparent 80%),
      var(--color-white);
    border: 1px solid rgba(25, 118, 233, 0.12);
    box-shadow:
      0 4px 10px rgba(7, 26, 45, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .tech-strip__icon {
    display: block;
    width: 26px;
    height: 26px;
  }

  .tech-strip__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: normal;
  }

  @media (min-width: 960px) {
    .tech-strip__name {
      white-space: nowrap;
    }
  }
</style>
