---
// Reused conceptual icons (Cybersecurity, Cloud & Infrastructure, Microsoft 365) plus three new ones.
// Assets: app/public/images/homepage/icons/
const services = [
  {
    title: "Managed IT & Help Desk",
    description: "Reliable, responsive support for your team.",
    iconSrc: "/images/homepage/icons/managed-it-support.svg",
    href: "/services/",
  },
  {
    title: "Microsoft 365 & Endpoint Management",
    description: "Maximize productivity and security.",
    iconSrc: "/images/homepage/icons/productivity-collaboration.svg",
    href: "/services/",
  },
  {
    title: "Cybersecurity",
    description: "Protect what matters with a proactive security approach.",
    iconSrc: "/images/homepage/icons/cybersecurity.svg",
    href: "/services/",
  },
  {
    title: "Cloud & Infrastructure",
    description: "Scalable, secure infrastructure for growth.",
    iconSrc: "/images/homepage/icons/cloud-infrastructure.svg",
    href: "/services/",
  },
  {
    title: "Network Services",
    description: "Modern, reliable networks that keep you connected.",
    iconSrc: "/images/homepage/icons/network-services.svg",
    href: "/services/",
  },
  {
    title: "Backup & Business Continuity",
    description: "Be ready for whatever comes next.",
    iconSrc: "/images/homepage/icons/business-continuity.svg",
    href: "/services/",
  },
];
---

<section class="core-services" aria-labelledby="core-services-heading">
  <div class="core-services__inner">
    <div class="core-services__header">
      <p class="core-services__eyebrow">OUR SERVICES</p>
      <h2 id="core-services-heading" class="core-services__heading">
        Complete IT services for a stronger, more secure business.
      </h2>
    </div>

    <ul class="core-services__list">
      {
        services.map((service) => (
          <li class="core-services__card">
            <span class="core-services__icon-badge">
              <img
                src={service.iconSrc}
                width="28"
                height="28"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
            <h3 class="core-services__title">{service.title}</h3>
            <p class="core-services__description">{service.description}</p>
            <a
              class="core-services__link"
              href={service.href}
              aria-label={`Learn more about ${service.title}`}
            >
              Learn More &rarr;
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the white Business Problem section above. */
  .core-services {
    background-color: var(--color-cloud-bg);
  }

  .core-services__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 24px 40px;
  }

  @media (min-width: 640px) {
    .core-services__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 28px 48px;
    }
  }

  @media (min-width: 960px) {
    .core-services__inner {
      padding-inline: var(--container-padding-desktop);
      /* Tighter top padding keeps this section flowing from Business Problem; bottom stays generous before the next dark section. */
      padding-block: 28px 50px;
    }
  }

  .core-services__header {
    max-width: 680px;
    margin: 0 auto 28px;
    text-align: center;
  }

  @media (min-width: 640px) {
    .core-services__header {
      margin-bottom: 32px;
    }
  }

  @media (min-width: 960px) {
    .core-services__header {
      margin-bottom: 30px;
    }
  }

  .core-services__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .core-services__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .core-services__heading {
      /* Slightly under the shared H2 token so this heading stays quieter than other sections. */
      font-size: 2.25rem;
    }
  }

  .core-services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .core-services__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (min-width: 960px) {
    .core-services__list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 18px;
    }
  }

  .core-services__card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: 20px;
  }

  .core-services__icon-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 16px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgba(25, 118, 233, 0.12), rgba(42, 197, 232, 0.04) 65%, transparent 80%),
      var(--color-soft-azure);
    border: 1px solid rgba(25, 118, 233, 0.14);
    box-shadow:
      0 2px 6px rgba(7, 26, 45, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .core-services__icon-badge img {
    display: block;
    width: 26px;
    height: 26px;
  }

  .core-services__title {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .core-services__title {
      font-size: 1.125rem;
    }
  }

  .core-services__description {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .core-services__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    font-size: 1rem;
    font-weight: 600;
    /* Blink Blue does not reliably meet AA behind normal-size text on white; Secondary Navy does. */
    color: var(--color-secondary-navy);
    text-decoration: none;
  }

  .core-services__link:hover {
    color: var(--color-blink-navy);
    text-decoration: underline;
  }
</style>
