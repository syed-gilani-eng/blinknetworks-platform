---
// Informational only, matching the six approved Services categories exactly — not links (no category-archive routes exist).
const topics = [
  {
    title: "Managed IT & Help Desk",
    description:
      "Practical advice on getting more from your IT support and day-to-day operations.",
    iconSrc: "/images/homepage/icons/managed-it-support.svg",
  },
  {
    title: "Microsoft 365 & Endpoint Management",
    description:
      "Tips, best practices and guidance for a more productive and secure Microsoft 365 environment.",
    iconSrc: "/images/homepage/icons/productivity-collaboration.svg",
  },
  {
    title: "Cybersecurity",
    description:
      "Actionable insights to help you reduce risk and strengthen your security posture.",
    iconSrc: "/images/homepage/icons/cybersecurity.svg",
  },
  {
    title: "Cloud & Infrastructure",
    description:
      "Ideas and guidance for building a more scalable and resilient IT environment.",
    iconSrc: "/images/homepage/icons/cloud-infrastructure.svg",
  },
  {
    title: "Network Services",
    description: "Insights on connectivity, performance and network reliability.",
    iconSrc: "/images/homepage/icons/network-services.svg",
  },
  {
    title: "Backup & Business Continuity",
    description:
      "Practical guidance to help you keep your data safe and your business running.",
    iconSrc: "/images/homepage/icons/business-continuity.svg",
  },
];
---

<section class="insights-topics" aria-labelledby="insights-topics-heading">
  <div class="insights-topics__inner">
    <div class="insights-topics__header">
      <p class="insights-topics__eyebrow">EXPLORE BY TOPIC</p>
      <h2 id="insights-topics-heading" class="insights-topics__heading">
        Explore by topic
      </h2>
    </div>

    <ul class="insights-topics__grid">
      {
        topics.map((topic) => (
          <li class="insights-topics__card">
            <img
              class="insights-topics__icon"
              src={topic.iconSrc}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="insights-topics__title">{topic.title}</h3>
            <p class="insights-topics__description">{topic.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the white Featured Insight section above. */
  .insights-topics {
    background-color: var(--color-cloud-bg);
  }

  .insights-topics__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 28px 32px;
  }

  @media (min-width: 640px) {
    .insights-topics__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 32px 36px;
    }
  }

  @media (min-width: 960px) {
    .insights-topics__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 36px 40px;
    }
  }

  .insights-topics__header {
    max-width: 680px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .insights-topics__eyebrow {
    margin: 0 0 12px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insights-topics__heading {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .insights-topics__heading {
      font-size: 2rem;
    }
  }

  .insights-topics__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .insights-topics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .insights-topics__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .insights-topics__card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: 20px;
  }

  .insights-topics__icon {
    margin-bottom: 14px;
  }

  .insights-topics__title {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .insights-topics__description {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
