---
// Reused existing homepage icons (no new assets); Canadian-Owned intentionally avoids
// flags/maple-leaf imagery per approved copy direction and uses a neutral location icon.
const differentiators = [
  {
    title: "Canadian-Owned",
    description: "Local understanding and accountable service for businesses across Toronto and the GTA.",
    iconSrc: "/images/homepage/icons/multi-location.svg",
  },
  {
    title: "Clear Communication",
    description: "Straightforward guidance, so you always know where things stand.",
    iconSrc: "/images/homepage/icons/productivity-collaboration.svg",
  },
  {
    title: "Security-Minded",
    description: "Every recommendation is made with security as a priority.",
    iconSrc: "/images/homepage/icons/cybersecurity.svg",
  },
  {
    title: "Built to Scale",
    description: "Right-sized solutions that grow with your business.",
    iconSrc: "/images/homepage/icons/growing-organizations.svg",
  },
];
---

<section class="services-why-blink" aria-labelledby="services-why-blink-heading">
  <div class="services-why-blink__inner">
    <div class="services-why-blink__content">
      <p class="services-why-blink__eyebrow">WHY BLINKNETWORKS</p>
      <h2 id="services-why-blink-heading" class="services-why-blink__heading">
        A technology partner you can rely on
      </h2>
    </div>

    <ul class="services-why-blink__items">
      {
        differentiators.map((item) => (
          <li class="services-why-blink__item">
            <img
              class="services-why-blink__icon"
              src={item.iconSrc}
              width="36"
              height="36"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="services-why-blink__item-title">{item.title}</h3>
            <p class="services-why-blink__item-description">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the white How We Work section above. */
  .services-why-blink {
    background-color: var(--color-soft-azure);
  }

  .services-why-blink__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media (min-width: 640px) {
    .services-why-blink__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .services-why-blink__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 40px;
    }
  }

  .services-why-blink__content {
    max-width: 46ch;
  }

  @media (min-width: 960px) {
    .services-why-blink__content {
      max-width: none;
    }
  }

  .services-why-blink__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .services-why-blink__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .services-why-blink__heading {
      font-size: 2.25rem;
    }
  }

  .services-why-blink__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .services-why-blink__items {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 24px;
      row-gap: 28px;
    }
  }

  @media (min-width: 960px) {
    .services-why-blink__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }

  /* Deliberately lightweight, matching the homepage's Why BlinkNetworks pattern: no card background, border, or shadow. */
  .services-why-blink__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .services-why-blink__icon {
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
  }

  .services-why-blink__item-title {
    margin: 0 0 6px;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .services-why-blink__item-description {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
