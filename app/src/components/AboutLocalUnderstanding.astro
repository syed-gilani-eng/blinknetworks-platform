---
// Reused existing homepage icons (no new assets): app/public/images/homepage/icons/
const supportingPoints = [
  {
    title: "Canadian-Owned",
    iconSrc: "/images/homepage/icons/location-pin.svg",
  },
  {
    title: "Responsive Partnership",
    iconSrc: "/images/homepage/icons/proactive-design.svg",
  },
  {
    title: "Modern Technical Capability",
    iconSrc: "/images/homepage/icons/cloud-infrastructure.svg",
  },
];
---

<section class="about-local" aria-labelledby="about-local-heading">
  <div class="about-local__inner">
    <!-- Approved production illustration; decorative, since the adjacent copy communicates the section meaning. -->
    <div class="about-local__visual">
      <img
        class="about-local__image"
        src="/images/about/local-partnership.webp"
        width="1448"
        height="1086"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-local__content">
      <p class="about-local__eyebrow">LOCAL UNDERSTANDING</p>
      <h2 id="about-local-heading" class="about-local__heading">
        Proudly serving Toronto and the GTA.
      </h2>
      <p class="about-local__lead">
        Being close to the businesses we support helps us understand the
        realities of growing organizations in our community. We combine
        local accountability with modern cloud, security and infrastructure
        capabilities.
      </p>

      <ul class="about-local__points">
        {
          supportingPoints.map((point) => (
            <li class="about-local__point">
              <img
                class="about-local__point-icon"
                src={point.iconSrc}
                width="28"
                height="28"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <h3 class="about-local__point-title">{point.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the Blink Navy How We Work section above. */
  .about-local {
    background-color: var(--color-white);
  }

  .about-local__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 640px) {
    .about-local__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .about-local__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 48px;
    }
  }

  .about-local__content {
    max-width: 46ch;
  }

  @media (min-width: 960px) {
    .about-local__content {
      max-width: none;
    }
  }

  .about-local__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-local__heading {
    margin: 0 0 20px;
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .about-local__heading {
      font-size: var(--font-size-h2);
    }
  }

  .about-local__lead {
    margin: 0 0 28px;
    max-width: 48ch;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .about-local__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 480px) {
    .about-local__points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .about-local__point {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .about-local__point-icon {
    width: 28px;
    height: 28px;
  }

  .about-local__point-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .about-local__visual {
    width: 100%;
  }

  /* Illustration already has its own pale-azure background; contain rather than crop, restrained rounding only. */
  .about-local__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-card);
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .about-local__visual {
      max-width: 500px;
      margin-inline: auto;
    }
  }
</style>
