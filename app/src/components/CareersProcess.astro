---
const steps = [
  {
    title: "Connect",
    description: "Introduce yourself and tell us what you're interested in.",
  },
  {
    title: "Conversation",
    description: "We'll have a relaxed conversation to learn more about you and your experience.",
  },
  {
    title: "Decision",
    description: "If it's a mutual fit, we'll be in touch with next steps.",
  },
];
---

<section class="careers-process" aria-labelledby="careers-process-heading">
  <div class="careers-process__inner">
    <header class="careers-process__header">
      <p class="careers-process__eyebrow">How we hire</p>
      <h2 id="careers-process-heading" class="careers-process__heading">
        A straightforward process
      </h2>
    </header>

    <ol class="careers-process__steps">
      {
        steps.map((step, index) => (
          <li class="careers-process__step">
            <div class="careers-process__step-number" aria-hidden="true">
              {index + 1}
            </div>
            <h3 class="careers-process__step-title">{step.title}</h3>
            <p class="careers-process__step-description">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Light, subtly blue-tinted background distinguishes this section from the white sections around it. */
  .careers-process {
    background-color: var(--color-soft-azure);
  }

  .careers-process__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 36px 40px;
  }

  @media (min-width: 640px) {
    .careers-process__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 40px 44px;
    }
  }

  @media (min-width: 960px) {
    .careers-process__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 44px 48px;
    }
  }

  .careers-process__header {
    max-width: 680px;
    margin: 0 auto 28px;
    text-align: center;
  }

  .careers-process__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .careers-process__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .careers-process__heading {
      font-size: 2.25rem;
    }
  }

  .careers-process__steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .careers-process__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }

    /* Light connecting line drawn behind the numbered circles, spanning between the first and last step. */
    .careers-process__steps::before {
      content: "";
      position: absolute;
      top: 20px;
      left: calc(100% / 6);
      right: calc(100% / 6);
      height: 1px;
      background-color: rgba(25, 118, 233, 0.25);
      z-index: 0;
    }
  }

  .careers-process__step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .careers-process__step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-blink-blue);
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .careers-process__step-title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .careers-process__step-description {
    margin: 0;
    max-width: 32ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
