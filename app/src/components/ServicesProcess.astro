---
// Reused existing process icons where semantically appropriate; process-plan.svg is new for this page.
const steps = [
  {
    title: "Assess",
    description: "Understand the business, its technology environment, priorities and risks.",
    iconSrc: "/images/homepage/icons/process-assess.svg",
  },
  {
    title: "Plan",
    description: "Develop a practical roadmap aligned with operational needs and budget.",
    iconSrc: "/images/homepage/icons/process-plan.svg",
  },
  {
    title: "Implement",
    description: "Deploy and configure the agreed solution with careful change management.",
    iconSrc: "/images/homepage/icons/process-modernize.svg",
  },
  {
    title: "Manage & Improve",
    description: "Provide ongoing support, monitoring and continuous improvement.",
    iconSrc: "/images/homepage/icons/process-manage-monitor-improve.svg",
  },
];
---

<section class="services-process" aria-labelledby="services-process-heading">
  <div class="services-process__inner">
    <header class="services-process__header">
      <p class="services-process__eyebrow">HOW WE WORK</p>
      <h2 id="services-process-heading" class="services-process__heading">
        A clear, collaborative process.
      </h2>
    </header>

    <ol class="services-process__steps">
      {
        steps.map((step, index) => (
          <li class="services-process__step">
            <div class="services-process__step-number" aria-hidden="true">
              {index + 1}
            </div>
            <img
              class="services-process__step-icon"
              src={step.iconSrc}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="services-process__step-title">{step.title}</h3>
            <p class="services-process__step-description">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the Cloud detailed-services section above. */
  .services-process {
    background-color: var(--color-white);
  }

  .services-process__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
  }

  @media (min-width: 640px) {
    .services-process__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .services-process__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
    }
  }

  .services-process__header {
    margin: 0 0 24px;
    max-width: 46ch;
  }

  @media (min-width: 960px) {
    .services-process__header {
      max-width: none;
    }
  }

  .services-process__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .services-process__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .services-process__heading {
      font-size: 2.25rem;
    }
  }

  .services-process__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 20px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .services-process__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (min-width: 960px) {
    .services-process__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 36px;
    }
  }

  /* Same two-row internal grid as the homepage's How It Works pattern. */
  .services-process__step {
    position: relative;
    display: grid;
    grid-template-columns: 40px 30px minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 10px;
    row-gap: 8px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    padding: 14px 16px;
  }

  @media (min-width: 960px) {
    .services-process__step:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 100%;
      width: 14px;
      height: 14px;
      margin-left: 11px;
      transform: translateY(-50%) rotate(45deg);
      border-top: 3px solid var(--color-blink-blue);
      border-right: 3px solid var(--color-blink-blue);
      pointer-events: none;
    }
  }

  .services-process__step-number {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-blink-blue);
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .services-process__step-icon {
    grid-column: 2;
    grid-row: 1;
    width: 28px;
    height: 28px;
  }

  .services-process__step-title {
    grid-column: 3;
    grid-row: 1;
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .services-process__step-description {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }
</style>
