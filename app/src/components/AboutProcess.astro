---
// Reused existing homepage icons (no new assets): app/public/images/homepage/icons/
const steps = [
  {
    title: "Listen",
    description: "Understand your environment, priorities and concerns.",
    iconSrc: "/images/homepage/icons/process-assess.svg",
  },
  {
    title: "Plan",
    description: "Create a practical path aligned with risk, budget and timing.",
    iconSrc: "/images/homepage/icons/process-plan.svg",
  },
  {
    title: "Deliver",
    description: "Implement carefully with clear communication.",
    iconSrc: "/images/homepage/icons/process-modernize.svg",
  },
  {
    title: "Stay Engaged",
    description: "Support, review and improve as needs change.",
    iconSrc: "/images/homepage/icons/process-manage-monitor-improve.svg",
  },
];
---

<section id="how-we-work" class="about-process" aria-labelledby="about-process-heading">
  <div class="about-process__inner">
    <header class="about-process__header">
      <p class="about-process__eyebrow">HOW WE WORK</p>
      <h2 id="about-process-heading" class="about-process__heading">
        Collaborative from the first conversation.
      </h2>
    </header>

    <ol class="about-process__steps">
      {
        steps.map((step, index) => (
          <li class="about-process__step">
            <div class="about-process__step-number" aria-hidden="true">
              {index + 1}
            </div>
            <img
              class="about-process__step-icon"
              src={step.iconSrc}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="about-process__step-title">{step.title}</h3>
            <p class="about-process__step-description">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Navy band treatment: background change alone marks the boundary with the white Values section above. */
  .about-process {
    background-color: var(--color-blink-navy);
    color: var(--color-white);
    /* Keeps the anchored heading clear of the header when jumped to via the Hero secondary CTA. */
    scroll-margin-top: 96px;
  }

  .about-process__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
  }

  @media (min-width: 640px) {
    .about-process__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .about-process__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
    }
  }

  .about-process__header {
    margin: 0 0 24px;
    max-width: 46ch;
  }

  @media (min-width: 960px) {
    .about-process__header {
      max-width: none;
    }
  }

  .about-process__eyebrow {
    margin: 0 0 16px;
    color: var(--color-network-cyan);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-process__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-white);
  }

  @media (min-width: 960px) {
    .about-process__heading {
      font-size: 2.25rem;
    }
  }

  .about-process__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 20px;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .about-process__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (min-width: 960px) {
    .about-process__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 36px;
    }
  }

  /* Secondary Navy card on the Blink Navy section, matching the existing dark-surface tile treatment. */
  .about-process__step {
    position: relative;
    display: grid;
    grid-template-columns: 40px 30px minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 10px;
    row-gap: 8px;
    background-color: var(--color-secondary-navy);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-card);
    padding: 14px 16px;
  }

  /* Desktop-only decorative chevron linking each card to the next, in the dark-surface accent color. */
  @media (min-width: 960px) {
    .about-process__step:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 100%;
      width: 14px;
      height: 14px;
      margin-left: 11px;
      transform: translateY(-50%) rotate(45deg);
      border-top: 3px solid var(--color-network-cyan);
      border-right: 3px solid var(--color-network-cyan);
      pointer-events: none;
    }
  }

  .about-process__step-number {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-network-cyan);
    color: var(--color-blink-navy);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .about-process__step-icon {
    grid-column: 2;
    grid-row: 1;
    width: 28px;
    height: 28px;
  }

  .about-process__step-title {
    grid-column: 3;
    grid-row: 1;
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-white);
  }

  .about-process__step-description {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-soft-azure);
  }

  /* Dark background: keep focus rings on the approved brighter accent rather than the default Blink Blue. */
  .about-process :focus-visible {
    outline-color: var(--color-network-cyan);
  }
</style>
