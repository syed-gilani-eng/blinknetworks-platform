---
// Reuses the existing homepage Copilot icon (no vendor mark); no new assets.
const capabilities = [
  "AI readiness and use-case assessment",
  "Microsoft 365 Copilot planning and rollout",
  "Workflow automation and system integration",
  "Security, governance and responsible-use guidance",
  "User training, adoption and ongoing optimization",
];
---

<section class="services-ai-feature" aria-labelledby="services-ai-feature-heading">
  <div class="services-ai-feature__inner">
    <div class="services-ai-feature__content">
      <img
        class="services-ai-feature__icon"
        src="/images/homepage/icons/copilot-ai.svg"
        width="40"
        height="40"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <p class="services-ai-feature__eyebrow">FEATURED SERVICE</p>
      <h2 id="services-ai-feature-heading" class="services-ai-feature__heading">
        AI Enablement &amp; Automation
      </h2>
      <p class="services-ai-feature__lead">
        Adopt useful AI and automation securely, with a practical plan
        built around your people, processes and existing technology.
      </p>
      <a class="services-ai-feature__cta" href="/contact/">Discuss Your AI Goals</a>
    </div>

    <ul class="services-ai-feature__capabilities">
      {capabilities.map((capability) => <li>{capability}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Background change alone marks the boundary with the Cloud Detailed Services section above. */
  .services-ai-feature {
    background-color: var(--color-blink-navy);
  }

  .services-ai-feature__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 640px) {
    .services-ai-feature__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .services-ai-feature__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 44px;
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 40px;
    }
  }

  .services-ai-feature__content {
    max-width: 46ch;
  }

  @media (min-width: 960px) {
    .services-ai-feature__content {
      max-width: none;
    }
  }

  .services-ai-feature__icon {
    width: 40px;
    height: 40px;
    margin-bottom: 16px;
  }

  .services-ai-feature__eyebrow {
    margin: 0 0 16px;
    color: var(--color-network-cyan);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .services-ai-feature__heading {
    margin: 0 0 20px;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-white);
  }

  @media (min-width: 960px) {
    .services-ai-feature__heading {
      font-size: 2.25rem;
    }
  }

  .services-ai-feature__lead {
    margin: 0 0 28px;
    max-width: 40ch;
    color: var(--color-soft-azure);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .services-ai-feature__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 24px;
    border-radius: var(--radius-button);
    background-color: var(--color-network-cyan);
    color: var(--color-blink-navy);
    border: 1px solid var(--color-network-cyan);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .services-ai-feature__cta:hover {
    background-color: var(--color-soft-azure);
    border-color: var(--color-soft-azure);
  }

  /* Dark background: keep focus rings on the approved brighter accent rather than the default Blink Blue. */
  .services-ai-feature :focus-visible {
    outline-color: var(--color-network-cyan);
  }

  .services-ai-feature__capabilities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .services-ai-feature__capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 24px;
    }
  }

  .services-ai-feature__capabilities li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--color-white);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Same rotated-corner bullet as the Hero trust list, reproduced locally rather than shared/imported. */
  .services-ai-feature__capabilities li::before {
    content: "";
    flex-shrink: 0;
    margin-top: 6px;
    width: 6px;
    height: 10px;
    border-right: 2px solid var(--color-network-cyan);
    border-bottom: 2px solid var(--color-network-cyan);
    transform: rotate(45deg);
  }
</style>
