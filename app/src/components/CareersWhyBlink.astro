---
// Reused existing homepage icons (no new assets): app/public/images/homepage/icons/
const traits = [
  {
    title: "Client-first service",
    description: "We put our clients' success at the centre of everything we do.",
    iconSrc: "/images/homepage/icons/built-for-smbs.svg",
  },
  {
    title: "Room to grow",
    description: "You'll have opportunities to expand your skills and take on new challenges.",
    iconSrc: "/images/homepage/icons/proactive-design.svg",
  },
  {
    title: "Real ownership",
    description: "We trust our team to take initiative and make an impact.",
    iconSrc: "/images/homepage/icons/accountable-partner.svg",
  },
];
---

<section class="careers-why-blink" aria-labelledby="careers-why-blink-heading">
  <div class="careers-why-blink__inner">
    <div class="careers-why-blink__header">
      <p class="careers-why-blink__eyebrow">Why BlinkNetworks</p>
      <h2 id="careers-why-blink-heading" class="careers-why-blink__heading">
        Work that matters
      </h2>
      <p class="careers-why-blink__lead">
        You&rsquo;ll work with a team that cares about doing great work,
        supporting real businesses, and building a stronger, more connected
        community across Toronto and the GTA.
      </p>
    </div>

    <ul class="careers-why-blink__list">
      {
        traits.map((trait) => (
          <li class="careers-why-blink__card">
            <span class="careers-why-blink__icon-badge">
              <img
                src={trait.iconSrc}
                width="28"
                height="28"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
            <h3 class="careers-why-blink__card-title">{trait.title}</h3>
            <p class="careers-why-blink__card-description">{trait.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .careers-why-blink {
    background-color: var(--color-white);
  }

  .careers-why-blink__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 40px 36px;
  }

  @media (min-width: 640px) {
    .careers-why-blink__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 44px 40px;
    }
  }

  @media (min-width: 960px) {
    .careers-why-blink__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 48px 44px;
    }
  }

  .careers-why-blink__header {
    max-width: 680px;
    margin: 0 0 32px;
  }

  .careers-why-blink__eyebrow {
    margin: 0 0 16px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .careers-why-blink__heading {
    margin: 0 0 16px;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .careers-why-blink__heading {
      font-size: 2.25rem;
    }
  }

  .careers-why-blink__lead {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .careers-why-blink__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .careers-why-blink__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
  }

  /* Subtle border, minimal shadow: editorial cards rather than floating dashboard tiles. */
  .careers-why-blink__card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    padding: 32px 28px;
  }

  .careers-why-blink__icon-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 16px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgba(25, 118, 233, 0.12), rgba(42, 197, 232, 0.04) 65%, transparent 80%),
      var(--color-soft-azure);
    border: 1px solid rgba(25, 118, 233, 0.14);
    box-shadow:
      0 2px 6px rgba(7, 26, 45, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .careers-why-blink__icon-badge img {
    display: block;
    width: 26px;
    height: 26px;
  }

  .careers-why-blink__card-title {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .careers-why-blink__card-title {
      font-size: 1.125rem;
    }
  }

  .careers-why-blink__card-description {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
