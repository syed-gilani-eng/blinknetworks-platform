---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleBreadcrumb from "../../components/ArticleBreadcrumb.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { insightsCategoryLabels } from "../../lib/insightsCategoryLabels";

export async function getStaticPaths() {
  const entries = await getCollection("insights", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleBreadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Insights", path: "/insights/" },
  { name: entry.data.title },
];

// UTC avoids the visible date shifting a day earlier in timezones behind UTC.
const dateFormatter = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const publishedDateLabel = dateFormatter.format(entry.data.publishedDate);
const updatedDateLabel = entry.data.updatedDate
  ? dateFormatter.format(entry.data.updatedDate)
  : undefined;
const showUpdatedDate = Boolean(
  updatedDateLabel && updatedDateLabel !== publishedDateLabel
);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/insights/${entry.id}/`}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  breadcrumbs={articleBreadcrumbs}
>
  <ArticleBreadcrumb currentTitle={entry.data.title} />

  <article class="article">
    <header class="article__header">
      <p class="article__category">
        {insightsCategoryLabels[entry.data.category]}
      </p>
      <h1 class="article__title">{entry.data.title}</h1>
      <p class="article__meta">
        <span class="article__byline">BlinkNetworks</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={entry.data.publishedDate.toISOString()}>
          {publishedDateLabel}
        </time>
        {
          showUpdatedDate && entry.data.updatedDate && updatedDateLabel && (
            <>
              <span aria-hidden="true">&middot;</span>
              <time datetime={entry.data.updatedDate.toISOString()}>
                Updated {updatedDateLabel}
              </time>
            </>
          )
        }
      </p>
    </header>

    <img
      class="article__image"
      src={entry.data.image}
      width="1536"
      height="1024"
      alt={entry.data.imageAlt}
      decoding="async"
      fetchpriority="high"
    />

    <div class="article__content">
      <Content />
    </div>
  </article>

  <FinalCTA
    eyebrow="NEED PRACTICAL GUIDANCE?"
    heading="Turn useful information into the right technology decisions."
    lead="Let's discuss your organization's priorities and find practical next steps."
    ctaLabel="Book a Consultation"
    ctaHref="/contact/"
    caption=""
  />
</ArticleLayout>

<style>
  .article {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 28px 40px;
  }

  @media (min-width: 640px) {
    .article {
      padding-inline: var(--container-padding-tablet);
      padding-block: 32px 48px;
    }
  }

  @media (min-width: 960px) {
    .article {
      padding-inline: var(--container-padding-desktop);
      padding-block: 36px 56px;
    }
  }

  .article__header {
    max-width: 70ch;
    margin: 0 auto 24px;
  }

  .article__category {
    margin: 0 0 12px;
    color: var(--color-blink-blue);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article__title {
    margin: 0 0 12px;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .article__title {
      font-size: 2.5rem;
    }
  }

  .article__meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  .article__byline {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .article__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 900px;
    margin: 0 auto 32px;
    border-radius: var(--radius-card);
    background-color: var(--color-soft-azure);
  }

  .article__content {
    max-width: 70ch;
    margin: 0 auto;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-primary);
  }

  .article__content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .article__content :global(h2:first-child) {
    margin-top: 0;
  }

  .article__content :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .article__content :global(p) {
    margin: 0 0 1.25rem;
  }

  .article__content :global(ul),
  .article__content :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }

  .article__content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article__content :global(a) {
    color: var(--color-secondary-navy);
    text-decoration: underline;
  }

  .article__content :global(a:hover),
  .article__content :global(a:focus-visible) {
    color: var(--color-blink-navy);
  }

  .article__content :global(strong) {
    font-weight: 700;
  }
</style>
