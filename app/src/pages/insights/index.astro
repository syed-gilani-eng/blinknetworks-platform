---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import InsightsHero from "../../components/InsightsHero.astro";
import FeaturedInsight from "../../components/FeaturedInsight.astro";
import InsightsTopics from "../../components/InsightsTopics.astro";
import LatestInsights from "../../components/LatestInsights.astro";
import FinalCTA from "../../components/FinalCTA.astro";

const entries = (await getCollection("insights", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const featuredEntries = entries.filter((entry) => entry.data.featured);
if (featuredEntries.length > 1) {
  throw new Error(
    `Insights hub allows at most one non-draft featured article, found ${featuredEntries.length}.`
  );
}
const [featured] = featuredEntries;
const hasPublishedEntries = entries.length > 0;

const latest = featured
  ? entries.filter((entry) => !entry.data.featured).slice(0, 3)
  : entries;
const showLatestInsights = latest.length > 0;
---

<BaseLayout
  title="IT Insights for Growing GTA Businesses | BlinkNetworks"
  description="Read practical IT insights for growing Toronto and GTA businesses, including managed IT, Microsoft 365, cybersecurity, cloud, infrastructure, and continuity guidance."
  canonicalPath="/insights/"
  headerVariant="dark"
>
  <InsightsHero />
  {featured && <FeaturedInsight entry={featured} />}
  <InsightsTopics />
  {
    showLatestInsights ? (
      <LatestInsights entries={latest} />
    ) : !hasPublishedEntries ? (
      <section class="insights-empty" aria-labelledby="insights-empty-heading">
        <div class="insights-empty__inner">
          <p class="insights-empty__eyebrow">LATEST INSIGHTS</p>
          <h2 id="insights-empty-heading" class="insights-empty__heading">
            No published insights yet.
          </h2>
          <p class="insights-empty__lead">
            Published guidance will appear here once new Insights articles are ready.
          </p>
        </div>
      </section>
    ) : null
  }
  <FinalCTA
    eyebrow="NEED PRACTICAL GUIDANCE?"
    heading="Turn useful information into the right technology decisions."
    lead="Let's discuss your organization's priorities and find practical next steps."
    ctaLabel="Book a Consultation"
    ctaHref="/contact/"
    caption=""
  />
</BaseLayout>

<style>
  .insights-empty {
    background-color: var(--color-white);
  }

  .insights-empty__inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding-mobile);
    padding-block: 32px 36px;
    text-align: center;
  }

  @media (min-width: 640px) {
    .insights-empty__inner {
      padding-inline: var(--container-padding-tablet);
      padding-block: 36px 40px;
    }
  }

  @media (min-width: 960px) {
    .insights-empty__inner {
      padding-inline: var(--container-padding-desktop);
      padding-block: 40px 48px;
    }
  }

  .insights-empty__eyebrow {
    margin: 0 0 12px;
    color: var(--color-secondary-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insights-empty__heading {
    margin: 0 0 12px;
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .insights-empty__heading {
      font-size: 2rem;
    }
  }

  .insights-empty__lead {
    margin: 0 auto;
    max-width: 54ch;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
