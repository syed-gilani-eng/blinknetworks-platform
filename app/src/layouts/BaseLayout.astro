---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface SeoProps {
  title: string;
  description: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  noindex?: boolean;
}

interface BreadcrumbItem {
  name: string;
  path?: string;
}

interface Props extends SeoProps {
  headerVariant?: "light" | "dark";
  includeWebSiteSchema?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  canonicalPath,
  socialImage,
  socialImageAlt,
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  headerVariant = "light",
  includeWebSiteSchema = false,
  breadcrumbs = [],
} = Astro.props;

const productionOrigin = "https://blinknetworks.com";

if (!Astro.site) {
  throw new Error(
    "BaseLayout SEO requires Astro.site to be configured as https://blinknetworks.com."
  );
}

const resolvedSiteURL = new URL(Astro.site.toString());

if (resolvedSiteURL.origin !== productionOrigin) {
  throw new Error(
    `BaseLayout SEO requires Astro.site to be exactly ${productionOrigin}, received ${resolvedSiteURL.origin}.`
  );
}

const stripQueryAndFragment = (value: string) => {
  const noFragment = value.split("#")[0] ?? "";
  return noFragment.split("?")[0] ?? "";
};

const ensureSiteRelativePath = (value: string, label: string) => {
  const trimmed = value.trim();

  if (!trimmed.startsWith("/") || trimmed.startsWith("//")) {
    throw new Error(`${label} must be a site-relative path that begins with a single /.`);
  }

  if (trimmed.includes(":")) {
    throw new Error(`${label} must not include a URI scheme or colon.`);
  }

  return trimmed;
};

const normalizeCanonicalPath = (value: string) => {
  const stripped = stripQueryAndFragment(ensureSiteRelativePath(value, "canonicalPath"));
  let path = stripped || "/";

  if (!path.startsWith("/")) {
    path = `/${path}`;
  }

  if (path === "/") {
    return "/";
  }

  return `${path.replace(/\/+$/, "")}/`;
};

const canonicalPathname = normalizeCanonicalPath(canonicalPath ?? Astro.url.pathname);
const canonicalURL = new URL(canonicalPathname, resolvedSiteURL);

const hasSocialImage = Boolean(socialImage?.trim());
const socialImageURL = hasSocialImage
  ? new URL(
      stripQueryAndFragment(ensureSiteRelativePath(socialImage!, "socialImage")),
      resolvedSiteURL
    ).toString()
  : undefined;

const serializeDate = (value?: Date | string) => {
  if (!value) {
    return undefined;
  }

  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) {
    return undefined;
  }

  return date.toISOString();
};

const publishedISO = serializeDate(publishedTime);
const modifiedISO = serializeDate(modifiedTime);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const twitterCard = hasSocialImage ? "summary_large_image" : "summary";

const normalizeBreadcrumbPath = (value: string, label: string) => {
  const trimmed = value.trim();

  if (!trimmed.startsWith("/") || trimmed.startsWith("//")) {
    throw new Error(`${label} must be a site-relative path that begins with a single /.`);
  }

  if (trimmed.includes(":")) {
    throw new Error(`${label} must not include a URI scheme or colon.`);
  }

  return trimmed === "/" ? "/" : trimmed.replace(/\/+$/, "") || "/";
};

const validatedBreadcrumbs = breadcrumbs.map((item, index) => {
  const name = item.name.trim();

  if (!name) {
    throw new Error(`Breadcrumb item ${index + 1} must have a non-empty name.`);
  }

  const isFinalItem = index === breadcrumbs.length - 1;

  if (!item.path && !isFinalItem) {
    throw new Error(`Breadcrumb item ${index + 1} requires a path unless it is the final breadcrumb.`);
  }

  const path = item.path ? normalizeBreadcrumbPath(item.path, `breadcrumbs[${index}].path`) : undefined;

  return {
    name,
    ...(path ? { path } : {}),
  };
});

const organizationSchema = {
  "@type": "Organization",
  "@id": "https://blinknetworks.com/#organization",
  name: "BlinkNetworks",
  url: "https://blinknetworks.com/",
  logo: {
    "@type": "ImageObject",
    url: "https://blinknetworks.com/brand/blinknetworks-logo-light-background.png",
  },
  description:
    "Managed IT, Microsoft 365, cybersecurity, cloud and infrastructure services for growing businesses across Toronto and the GTA.",
  email: "hello@blinknetworks.com",
  telephone: "+1-905-703-7895",
  sameAs: ["https://www.linkedin.com/company/blinknetworks/"],
};

const websiteSchema = includeWebSiteSchema
  ? {
      "@type": "WebSite",
      "@id": "https://blinknetworks.com/#website",
      url: "https://blinknetworks.com/",
      name: "BlinkNetworks",
      publisher: { "@id": "https://blinknetworks.com/#organization" },
    }
  : null;

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalURL.toString(),
  url: canonicalURL.toString(),
  name: title,
  description,
  isPartOf: { "@id": "https://blinknetworks.com/#website" },
  about: { "@id": "https://blinknetworks.com/#organization" },
  ...(validatedBreadcrumbs.length > 0
    ? { breadcrumb: { "@id": `${canonicalURL.toString()}#breadcrumb` } }
    : {}),
};

const breadcrumbListSchema =
  validatedBreadcrumbs.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonicalURL.toString()}#breadcrumb`,
        itemListElement: validatedBreadcrumbs.map((item, index) => {
          const listItem: Record<string, unknown> = {
            "@type": "ListItem",
            position: index + 1,
            name: item.name,
          };

          if (item.path) {
            listItem.item = new URL(item.path, resolvedSiteURL).toString();
          }

          return listItem;
        }),
      }
    : null;

const graph = [
  organizationSchema,
  ...(websiteSchema ? [websiteSchema] : []),
  webPageSchema,
  ...(breadcrumbListSchema ? [breadcrumbListSchema] : []),
];

const jsonLdScriptValue = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-8MCPFCT1D0"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-8MCPFCT1D0");
    </script>
    <meta name="robots" content={robotsContent} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      hasSocialImage && (
        <>
          <meta property="og:image" content={socialImageURL} />
          <meta name="twitter:image" content={socialImageURL} />
          {socialImageAlt && (
            <meta property="og:image:alt" content={socialImageAlt} />
          )}
          {socialImageAlt && (
            <meta name="twitter:image:alt" content={socialImageAlt} />
          )}
        </>
      )
    }
    {
      ogType === "article" &&
        publishedISO && (
          <meta property="article:published_time" content={publishedISO} />
        )
    }
    {
      ogType === "article" &&
        modifiedISO && (
          <meta property="article:modified_time" content={modifiedISO} />
        )
    }
    <title>{title}</title>
    <Fragment slot="head">
      <script type="application/ld+json" set:html={jsonLdScriptValue} />
    </Fragment>
    <slot name="head" />
  </head>
  <body>
    <Header variant={headerVariant} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
