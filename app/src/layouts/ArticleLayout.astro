---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image: string;
  imageAlt: string;
  publishedDate: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  canonicalPath,
  image,
  imageAlt,
  publishedDate,
  updatedDate,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const imageURL = new URL(image, Astro.site);
const logoURL = new URL(
  "/brand/blinknetworks-logo-light-background.png",
  Astro.site
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: imageURL.toString(),
  datePublished: publishedDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    "@type": "Organization",
    name: "BlinkNetworks",
  },
  publisher: {
    "@type": "Organization",
    name: "BlinkNetworks",
    logo: {
      "@type": "ImageObject",
      url: logoURL.toString(),
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.toString(),
  },
};

// Escapes '<' so a value containing "</script>" can't terminate the script element early.
const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<BaseLayout
  title={`${title} | BlinkNetworks`}
  description={description}
  canonicalPath={canonicalPath}
  socialImage={image}
  socialImageAlt={imageAlt}
  ogType="article"
  publishedTime={publishedDate}
  modifiedTime={updatedDate}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={serializedJsonLd} />
  </Fragment>
  <slot />
</BaseLayout>
